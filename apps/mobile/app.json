{
  "expo": {
    "name": "Nest",
    "slug": "nest",
    "scheme": "nest",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "ch.drrius.nest",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "platforms": ["ios"],
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-sqlite",
      [
        "expo-calendar",
        {
          "calendarPermission": "Nest reads your calendars to show your agenda. Only calendars you choose share busy times, without event details.",
          "remindersPermission": false
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a receipt photo to attach to an expense in Nest.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aca37c4f-1bcd-4e9a-a695-37e794f97933"
      }
    },
    "owner": "drrius-dev"
  }
}
