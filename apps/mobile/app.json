{
  "expo": {
    "name": "Nest",
    "slug": "nest",
    "scheme": "nest",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "ch.drrius.nest.dev",
      "supportsTablet": false
    },
    "platforms": ["ios"],
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Nest reads your calendars to show your agenda. Only calendars you choose share busy times, without event details.",
          "remindersPermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b733c351-a149-4b49-b9df-e8c2a14514e2"
      }
    },
    "owner": "drrius"
  }
}
