# Use an isolated development backend, never production migration credentials.
NEST_SUPABASE_URL=https://isolated-project.supabase.co
NEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
NEST_API_PORT=8787

# Optional server-only AI Gateway credentials and an explicitly selected model ID.
# Requires a model and either an API key or explicit vercel-oidc authentication.
# Otherwise generation returns 503; private history stays readable.
AI_GATEWAY_API_KEY=
NEST_AI_MODEL=
# Nest's selected deployment uses openai/gpt-6-luna with high reasoning.
NEST_AI_REASONING_EFFORT=
# On Vercel, vercel-oidc uses the deployment identity. No token belongs in client config.
NEST_AI_AUTH=

# Optional server-only secret for private meal generation. Never put this in mobile config.
NEST_SUPABASE_PLANNING_SECRET=
