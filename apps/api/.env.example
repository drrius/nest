# Use an isolated development backend, never production migration credentials.
NEST_SUPABASE_URL=https://isolated-project.supabase.co
NEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
NEST_API_PORT=8787

# Optional server-only AI Gateway credentials and an explicitly selected model ID.
# With either unset, assistant generation returns 503; private history stays readable.
AI_GATEWAY_API_KEY=
NEST_AI_MODEL=

# Optional server-only secret for private meal generation. Never put this in mobile config.
NEST_SUPABASE_PLANNING_SECRET=
