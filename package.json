{
  "name": "nest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "start": "pnpm --filter @nest/mobile start",
    "test:busy": "node --test tests/database/busy-snapshots.test.mjs",
    "test:calendar": "node --test apps/mobile/tests/calendar*.test.mjs",
    "test:session": "node --test apps/mobile/tests/session*.test.mjs apps/mobile/tests/sign-out-*.test.mjs",
    "test:database": "node --test tests/database/*.test.mjs",
    "test": "pnpm -r --if-present test",
    "test:offline": "node --test apps/mobile/tests/offline*.test.mjs",
    "test:domain": "pnpm --filter @nest/domain test",
    "test:ai": "pnpm --filter @nest/ai test",
    "test:approvals": "node --test tests/database/approvals.test.mjs",
    "test:groceries": "node --test tests/database/groceries.test.mjs",
    "test:conversations": "node --test tests/database/conversations.test.mjs",
    "test:chores": "node --test apps/mobile/tests/chore-*.test.mjs",
    "test:checklist": "node --test apps/mobile/tests/grocery-*.test.mjs",
    "test:assistant": "node --test apps/mobile/tests/assistant-*.test.mjs",
    "test:food": "node --test apps/mobile/tests/food-*.test.mjs",
    "test:cooking": "node --test apps/mobile/tests/cooking-*.test.mjs",
    "test:memory": "node --test apps/mobile/tests/memory-*.test.mjs",
    "test:notifications": "node --test apps/mobile/tests/notification-*.test.mjs apps/mobile/tests/push-*.test.mjs apps/mobile/tests/reminder-*.test.mjs apps/mobile/tests/renewal-*.test.mjs apps/mobile/tests/recurring-reminder-*.test.mjs",
    "test:setup": "node --test apps/mobile/tests/setup-*.test.mjs",
    "test:routines": "node --test apps/mobile/tests/routine-*.test.mjs",
    "test:money": "node --test apps/mobile/tests/money-*.test.mjs",
    "test:meals": "node --test apps/mobile/tests/meal-*.test.mjs",
    "test:integration:core": "node --test --test-concurrency=2 tests/integration/chore-postgrest.test.mjs tests/integration/grocery-postgrest.test.mjs tests/integration/expense-native-approval.test.mjs tests/integration/expense-save-restart.test.mjs tests/integration/pending-financial-approvals.test.mjs tests/integration/pending-approval-runtime.test.mjs",
    "test:integration:conflicts": "node --test --test-concurrency=2 tests/integration/ai-financial-proposal-conflicts.test.mjs tests/integration/financial-history-conflicts.test.mjs tests/integration/ai-turn-conflicts.test.mjs tests/integration/ai-turn-freeze-recovery.test.mjs tests/integration/preference-conflicts.test.mjs tests/integration/expense-nonretryable-conflicts.test.mjs tests/integration/calendar-postgrest.test.mjs tests/integration/memory-postgrest.test.mjs tests/integration/chore-changes-postgrest.test.mjs tests/integration/chore-transfers-postgrest.test.mjs tests/integration/renewal-conflicts.test.mjs tests/integration/recurring-terminal-conflicts.test.mjs tests/integration/meal-edit-conflicts.test.mjs tests/integration/recipe-conflicts.test.mjs tests/integration/ingredient-conflicts.test.mjs tests/integration/preparation-conflicts.test.mjs tests/integration/proposal-conflicts.test.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "eslint-plugin-expo": "1.1.0",
    "eslint-plugin-react-native": "5.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
